script-source,3,osr-bug.js,// Lines 146-154 (+ summary item 10\x2C line 37): OSR + reduce callback from different environments.\n// Usage: d8 osr-bug.js -- <variant> <n> [opt]   |  node osr-bug.js <variant> <n> [opt]\nconst isD8 = typeof process === 'undefined';\nconst log = isD8 ? print : console.log;\nconst argv = isD8 ? arguments : process.argv.slice(2);\nconst variant = argv[0]\x2C N = +argv[1]\x2C mode = argv[2] || 'plain';\nconst arr = [1\x2C 2\x2C 3\x2C 4\x2C 5\x2C 6\x2C 7\x2C 8\x2C 9\x2C 10];\nfunction doOuter(a\x2C b) { return a + b; }\nvar doOuterVar = function (a\x2C b) { return a + b; };\nconst doOuterConst = function (a\x2C b) { return a + b; };\nconst outerArrow = (a\x2C b) => a + b;\nconst V = {\n  literal(n) { let s = 0; while (n--) s += arr.reduce((a\x2C b) => a + b\x2C 0); return s; }\x2C\n  inner(n) { function doInner(a\x2C b) { return a + b; } let s = 0; while (n--) s += arr.reduce(doInner\x2C 0); return s; }\x2C\n  globalFn(n) { let s = 0; while (n--) s += arr.reduce(doOuter\x2C 0); return s; }\x2C\n  aliasInside(n) { var doInner = doOuter; let s = 0; while (n--) s += arr.reduce(doInner\x2C 0); return s; }\x2C\n  globalVar(n) { let s = 0; while (n--) s += arr.reduce(doOuterVar\x2C 0); return s; }\x2C\n  globalConst(n) { let s = 0; while (n--) s += arr.reduce(doOuterConst\x2C 0); return s; }\x2C\n  globalConstArrow(n) { let s = 0; while (n--) s += arr.reduce(outerArrow\x2C 0); return s; }\x2C\n  // workaround from line 154: loop body in a small local function\n  innerWrapped(n) { function doInner(a\x2C b) { return a + b; } function doSum() { return arr.reduce(doInner\x2C 0); } let s = 0; while (n--) s += doSum(); return s; }\x2C\n  constArrowWrapped(n) { function doSum() { return arr.reduce(outerArrow\x2C 0); } let s = 0; while (n--) s += doSum(); return s; }\x2C\n};\nconst doMain = V[variant];\nif (mode === 'opt') { %PrepareFunctionForOptimization(doMain); doMain(3); doMain(3); %OptimizeFunctionOnNextCall(doMain); }\nconst t0 = Date.now();\nconst r = doMain(N);\nlog(`${variant.padEnd(18)} mode=${mode} n=${N} ms=${Date.now() - t0} r=${r}`);\n
