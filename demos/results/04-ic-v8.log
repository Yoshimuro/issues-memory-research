code-creation,Script,10,9719,0x23b2010000d0,130, /home/user/issues-memory-research/demos/04-ic-shapes.js:1:1,0x3fe50101e1d4,~
script-source,3,/home/user/issues-memory-research/demos/04-ic-shapes.js,// \u0414\u0435\u043c\u043e 4 (\u0432\u043e\u0440\u043a\u043b\u043e\u0430\u0434 \u0434\u043b\u044f d8): getX(o){return o.x} \u043a\u043e\u0440\u043c\u0438\u043c 1 -> 2 -> 3 -> 4 -> 5 \u0448\u0435\u0439\u043f\u0430\u043c\u0438.\n// IC-\u043f\u0435\u0440\u0435\u0445\u043e\u0434\u044b \u043f\u0438\u0448\u0443\u0442\u0441\u044f \u0444\u043b\u0430\u0433\u043e\u043c --log-ic (\u0431\u044b\u0432\u0448\u0438\u0439 --trace-ic) \u0432 v8.log\x2C \u0441\u043c. 04-log-ic-run.js.\nfunction getX(o) {\n  return o.x;\n}\n\n// 5 \u043e\u0431\u044a\u0435\u043a\u0442\u043e\u0432 \u0441 \u0440\u0430\u0437\u043d\u044b\u043c\u0438 hidden classes: 'x' \u043d\u0430 \u0440\u0430\u0437\u043d\u044b\u0445 \u043f\u043e\u0437\u0438\u0446\u0438\u044f\u0445.\nconst shapes = [\n  { x: 1 }\x2C\n  { a: 1\x2C x: 2 }\x2C\n  { a: 1\x2C b: 2\x2C x: 3 }\x2C\n  { b: 1\x2C x: 4 }\x2C\n  { c: 1\x2C d: 2\x2C e: 3\x2C x: 5 }\x2C\n];\n\nlet sink = 0;\nfor (let s = 0; s < shapes.length; s++) {\n  const o = shapes[s];\n  for (let i = 0; i < 400; i++) sink += getX(o);\n  print(`\u043f\u043e\u0441\u043b\u0435 \u0448\u0435\u0439\u043f\u0430 #${s + 1}: sink=${sink}`);\n}\n
